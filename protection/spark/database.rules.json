                  ".write": "auth != null && auth.token.email_verified == true && root.child('spark/access').child(auth.uid).child('enabled').val() == true && root.child('spark/access').child(auth.uid).child('profile').val() == 'boss' && !data.exists()",
                  ".validate": "newData.hasChildren(['at','uid','op','deleted','payload']) && $version == newData.parent().parent().child('head').val()+'' && newData.child('at').val() == now && newData.child('uid').val() == auth.uid && newData.child('op').isString() && newData.child('op').val().length <= 100 && newData.child('deleted').isBoolean() && (newData.child('deleted').val() == false || root.child('spark/access').child(auth.uid).child('profile').val() == 'boss')",
                  "at": {
                    ".validate": "newData.isNumber()"
